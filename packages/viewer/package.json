{
  "name": "muse-encore-viewer",
  "version": "0.1.2",
  "description": "Show MuseScore files (.mscz/.mscx) in a web page like an inline PDF viewer: pages, continuous views, zoom, printing, full screen and playback. Based on MuseEncore, a TypeScript port of MuseScore Studio's engraving engine.",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/muse-encore-viewer.js",
  "module": "./dist/muse-encore-viewer.js",
  "types": "./dist/muse-encore-viewer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/muse-encore-viewer.d.ts",
      "import": "./dist/muse-encore-viewer.js"
    },
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "browser": "./dist/muse-encore-viewer.js",
  "jsdelivr": "./dist/muse-encore-viewer.js",
  "unpkg": "./dist/muse-encore-viewer.js",
  "files": [
    "dist",
    "fonts",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "musescore",
    "mscz",
    "mscx",
    "sheet music",
    "music notation",
    "score viewer",
    "engraving"
  ],
  "homepage": "https://pstaender.github.io/muse-encore/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pstaender/muse-encore.git",
    "directory": "packages/viewer"
  },
  "bugs": "https://github.com/pstaender/muse-encore/issues"
}
