{
  "name": "museencore",
  "version": "0.1.0",
  "description": "TypeScript port of the MuseScore Studio (v4.7.5) engraving engine: read .mscz/.mscx files and render them in the browser",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dev": "vite viewer",
    "build:viewer": "vite build viewer",
    "dev:editor": "vite editor",
    "build:editor": "vite build editor",
    "render": "tsx tools/render.ts",
    "compare": "tsx tools/compare.ts",
    "compare:all": "tsx tools/compare-all.ts",
    "compare:mscx": "tsx tools/compare-mscx.ts",
    "roundtrip": "tsx tools/roundtrip.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "opentype.js": "^2.0.0",
    "spessasynth_lib": "^4.3.14"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "1.56.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
